{
  "info": {
    "name": "BOOKIA API",
    "description": "Example requests for the BOOKIA REST API. Run `npm run seed` and `npm run dev`, set adminEmail/adminPassword, then run the folders in order. Ids are stored in collection variables automatically and the session cookie is kept by Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "adminEmail",
      "value": "admin@bookia.local"
    },
    {
      "key": "adminPassword",
      "value": "CHANGE_ME"
    },
    {
      "key": "readerEmail",
      "value": "lectora@example.com"
    },
    {
      "key": "bookId",
      "value": ""
    },
    {
      "key": "storeId",
      "value": ""
    },
    {
      "key": "newStoreId",
      "value": ""
    },
    {
      "key": "newBookId",
      "value": ""
    },
    {
      "key": "newOfferId",
      "value": ""
    },
    {
      "key": "offerId",
      "value": ""
    },
    {
      "key": "reservationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Public catalog",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"status 200\", () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Search books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?q=rulfo&max_price=300&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "q",
                  "value": "rulfo"
                },
                {
                  "key": "max_price",
                  "value": "300"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"bookId\", pm.response.json().items[0]._id);",
                  "pm.collectionVariables.set(\"offerId\", pm.response.json().items[0].offers[0]._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Book filters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/filters",
              "host": ["{{baseUrl}}"],
              "path": ["books", "filters"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"status 200\", () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Book detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"status 200\", () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Store directory",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stores",
              "host": ["{{baseUrl}}"],
              "path": ["stores"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"storeId\", pm.response.json()[0]._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Store detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stores/{{storeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["stores", "{{storeId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"status 200\", () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Books sold by one store",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?store_id={{storeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "store_id",
                  "value": "{{storeId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"status 200\", () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Reader account, favorites and reservations",
      "item": [
        {
          "name": "Register reader (409 if it already exists)",
          "request": {
            "method": "POST",
