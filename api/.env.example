# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/bookia
# Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=28800
CLIENT_URL=http://localhost:5173
BCRYPT_SALT_ROUNDS=12
# Used only by `npm run seed` to create the admin account
ADMIN_EMAIL=admin@bookia.local
ADMIN_PASSWORD=
